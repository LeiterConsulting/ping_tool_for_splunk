{
  "config_schema_version": 2,
  "monitoring": {
    "pings_per_cycle": 4,
    "cycle_interval_seconds": 60,
    "timeout_ms": 1000,
    "parallel_threads": 10,
    "emit_individual_pings": true,
    "ping": {
      "mode": "auto"
    }
  },
  "health": {
    "down_after_failures": 3,
    "recovery_after_successes": 2,
    "stale_after_intervals": 2
  },
  "logging": {
    "results": {
      "path": "./logs/ping_results.log",
      "max_size_mb": 50,
      "retention_files": 10,
      "retention_days": 14,
      "compress_rotated": true
    }
  },
  "outputs": {
    "mode": "file",
    "hec": {
      "enabled": false,
      "url": "",
      "token": "",
      "index": "main",
      "sourcetype": "ping_monitor",
      "verify_ssl": true,
      "ssl_protocol": "Default",
      "batch_size": 100,
      "drop_on_failure": false,
      "max_buffer_events": 5000,
      "max_buffer_bytes": "5MB",
      "retry": {
        "enabled": false,
        "max_attempts": 3,
        "base_delay_ms": 250,
        "jitter_pct": 20,
        "backoff": "exponential"
      },
      "retry_count": 0,
      "retry_delay_ms": 250,
      "dead_letter_path": "",
      "dead_letter_rotation_size_mb": 0,
      "use_ack": false,
      "ack_timeout_seconds": 60,
      "ack_poll_interval_ms": 1000,
      "channel": ""
    },
    "metrics": {
      "enabled": false,
      "mode": "dual",
      "index": "",
      "hec_url": "",
      "token": "",
      "verify_ssl": true,
      "ssl_protocol": "Default",
      "compat_mode": true,
      "sourcetype": "ping_monitor:metrics",
      "event_name": "metric",
      "use_metrics_index": false,
      "batch_size": 100,
      "max_buffer_events": 5000,
      "max_buffer_bytes": "5MB",
      "use_ack": false,
      "ack_timeout_seconds": 60,
      "ack_poll_interval_ms": 1000,
      "channel": ""
    },
    "delivery": {
      "spool_path": "./data/outbox",
      "max_spool_bytes": "512MB",
      "max_envelopes": 10000,
      "drain_max_envelopes": 100
    }
  },
  "discovery": {
    "history_path": "./data/discovery",
    "retention_scans": 0,
    "retention_days": 365,
    "schedules": []
  },
  "diagnostics": {
    "enabled": false,
    "handle_probe_mode": "none"
  },
  "debug": {
    "emit_memory_stats": false
  }
}
